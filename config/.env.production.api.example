# Production API template. Configure these in the API hosting platform, not in Git.
# Keep DB_USERNAME, DB_PASSWORD, and JWT_SECRET in the platform secret manager.
# DB_HOST is not a credential and may be configured as a regular environment value.
DB_HOST=<cluster-host>.mongodb.net
DB_USERNAME=<secret-manager-value>
DB_PASSWORD=<secret-manager-value>
DB_NAME=miriaxcargo
JWT_SECRET=<at-least-32-random-bytes>
JWT_EXPIRY=6000
FRONTEND_URL=https://your-pages-domain.pages.dev

# Alternatively, replace DB_HOST/DB_USERNAME/DB_PASSWORD with one server-only
# MONGODB_URI secret. Do not configure either form as a VITE_* variable.
