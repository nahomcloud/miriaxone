# Local API and Docker Compose settings. Copy to the repository root as .env.local.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/miriaxcargo?retryWrites=true&w=majority
DB_NAME=miriaxcargo
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRY=6000
FRONTEND_URL=http://localhost:8080,http://localhost:5174,http://127.0.0.1:5174
ROOT_EMAIL=root@example.com
ROOT_PASSWORD=replace-with-a-strong-password
ROOT_USERNAME=root
